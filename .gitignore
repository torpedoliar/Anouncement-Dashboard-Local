# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
dev.db

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
!.env.production
# template secret (CHANGE_ME) — aman di-commit
!.env.server.example

# docker dev override (expose DB ke host untuk npm run dev lokal)
docker-compose.override.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# graphify / planning research caches (regenerated, never commit)
.planning/research/.cache/

# agent & IDE local config
/.claude/
/.impeccable/hook.*.json
/.impeccable/config.local.json
/.kilo/
/.kilocode/
scripts/backups/
backups/

# Docker compose is now tracked (secrets moved to server-side .env via env_file).
# Keep docker-compose.override.yml ignored (dev-only, may contain local secrets).

# graphify cache
graphify-out/cache/

# lokal saja: artefak workflow superpowers (brief/report/diff SDD)
.superpowers/

# snapshot config server produksi — berisi secrets inline, JANGAN pernah di-commit
From Server Prod/

# screenshot liar di root (tidak direferensikan kode mana pun)
/image.png

