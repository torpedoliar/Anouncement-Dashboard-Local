# TEMPLATE secret produksi — COPY ke server, isi nilainya, JANGAN commit.
# Buat/ganti .env.server di server (atau isi nilai ini ke .env server yang dipakai
# docker compose). docker-compose.yml membaca NEXTAUTH_SECRET/CRON_SECRET/
# PEXELS_API_KEY/PORTAL_CREDENTIAL_KEY dari sini.

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# Scheduler Bearer — Generate: openssl rand -hex 16
CRON_SECRET=CHANGE_ME

# (opsional) Key Pexels utk stock media
PEXELS_API_KEY=CHANGE_ME

# PORTAL AES-256-GCM key (64 hex) — MANDATORY. Sama dengan yang dipakai enkripsi
# kredensial portal yang TERSIMPAN. Ganti = data terenkripsi lama tidak terbaca.
# 64 hex chars (32 byte) — Generate: openssl rand -hex 32
PORTAL_CREDENTIAL_KEY=CHANGE_ME

# (opsional) Portal Session — max age detik. Default: 43200 (12 jam)
# PORTAL_SESSION_MAX_AGE=43200

