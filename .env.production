# PRODUCTION non-secret config — COMMITTED (aman untuk git)
# Secrets (NEXTAUTH_SECRET, CRON_SECRET, PORTAL_CREDENTIAL_KEY, dst.) TIDAK di sini.
# Server mengisi secret via .env (di-ignore, contoh: .env.server).
# docker-compose.yml membaca file ini via env_file, lalu variabel ${...} diisi
# dari lingkungan (file .env adalah default sumber env saat docker compose up).

# ==== AUTH (dua host: domain + IP) ====
# AUTH_TRUST_HOST=true + NEXTAUTH_URL kosong → NextAuth detect origin per-request
# (next-auth detectOrigin: tanpa AUTH_TRUST_HOST selalu pakai NEXTAUTH_URL).
NEXTAUTH_URL=
AUTH_TRUST_HOST=true

# ==== FEATURES ====
ENABLE_AUTO_UPDATE=true

# ==== AUDIT TRAIL ====
AUDIT_RETENTION_DAYS=365

# ==== PORTAL SESSION ====
PORTAL_SESSION_MAX_AGE=43200
